@* Page for the NT 4 litehtml client: static HTML + CSS, no script. The server sets the refresh rate. *@
@inject LiteTimer Timer
@inject LiteChartData Charts

@{
    var elapsed = Timer.Elapsed;
    var running = Timer.Running;
    var percent = Timer.Percent;
    var done = percent >= 100;
    var status = running ? "läuft" : done ? "fertig" : elapsed > TimeSpan.Zero ? "angehalten" : "bereit";
    var (line, bars, tick) = Charts.Snapshot();
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>Server-Timer</title>
    <meta http-equiv="refresh" content="1;url=/lite" />
    <style>
        body { background: #060916; color: #e8eeff; font-family: Arial, sans-serif; font-size: 13px; margin: 0; padding: 10px 14px; }
        .card { background: #111a33; border: 1px solid #23305a; padding: 8px 12px; margin-bottom: 8px; }
        .eyebrow { color: #4fe3ff; font-size: 11px; font-weight: bold; letter-spacing: 3px; margin: 0; }
        .muted { color: #8292b8; font-size: 12px; margin: 0; }
        .head { color: #4fe3ff; font-weight: bold; margin: 0 0 6px 0; }
        .bar { background: #060916; border: 1px solid #23305a; height: 18px; margin: 6px 0; }
        .fill { height: 18px; background: linear-gradient(to right, #1f6f8b, #4fe3ff); }
        .time { font-size: 22px; font-weight: bold; color: #e8eeff; }
        .labels td { color: #8292b8; font-size: 11px; text-align: center; }
        a.btn { background: #4fe3ff; color: #060916; padding: 4px 12px; margin-right: 6px; font-weight: bold; text-decoration: none; }
        a.ghost { background: #23305a; color: #e8eeff; }
    </style>
</head>
<body>
    <div class="card">
        <p class="eyebrow">STYKKER LITE</p>
        <p class="muted">litehtml auf NT 4, ohne JavaScript. Serverzeit @DateTime.Now.ToString("HH:mm:ss") · Takt 1 s</p>
    </div>

    <div class="card">
        <span class="time">@elapsed.ToString(@"mm\:ss") / @Timer.Duration.ToString(@"mm\:ss")</span>
        <span class="muted">&nbsp; @percent % · @status</span>
        <div class="bar"><div class="fill" style="width: @(percent)%"></div></div>
        <a class="btn" href="/lite?cmd=start" accesskey="s">Start (S)</a>
        <a class="btn ghost" href="/lite?cmd=stop" accesskey="p">Pause (P)</a>
        <a class="btn ghost" href="/lite?cmd=reset" accesskey="r">Reset (R)</a>
        <a class="btn ghost" href="/lite/axes?ms=200" accesskey="a">Achsen (A)</a>
    </div>

    <div class="card">
        <p class="head">Last (SVG) · aktuell @(line.Length > 0 ? Math.Round(line[^1]) : 0) %</p>
        <img src="/lite/line.svg?v=@tick" width="560" height="110" alt="Last" />
    </div>

    <div class="card">
        <p class="head">Woche (SVG)</p>
        <img src="/lite/bars.svg?v=@tick" width="560" height="90" alt="Woche" />
        <table width="560" class="labels"><tr>
            @for (int i = 0; i < bars.Length; i++)
            {
                <td>@LiteChartData.BarLabels[i] @Math.Round(bars[i])</td>
            }
        </tr></table>
    </div>
</body>
</html>
