@* Axis positions for the NT 4 litehtml client. Values are computed per request, the client refreshes every IntervalMs. *@
@using System.Globalization

@code {
    [Parameter] public int IntervalMs { get; set; } = 200;

    private record Axis(string Name, string Unit, double Min, double Max, double Value);

    private static readonly int[] Speeds = [1000, 500, 200, 100, 50];

    private static Axis[] ReadAxes(double t) =>
    [
        new("X", "mm", -250, 250, 200 * Math.Sin(t * 0.7)),
        new("Y", "mm", -150, 150, 120 * Math.Cos(t * 0.5)),
        new("Z", "mm", 0, 100, 50 + 45 * Math.Sin(t * 1.3)),
        new("A", "°", 0, 360, (t * 40) % 360),
    ];

    private static string Fmt(double v) => v.ToString("+0.000;-0.000", CultureInfo.InvariantCulture);
}

@{
    var now = DateTime.Now;
    var axes = ReadAxes(now.TimeOfDay.TotalSeconds);
    var seconds = (IntervalMs / 1000.0).ToString("0.###", CultureInfo.InvariantCulture);
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>Achsen @IntervalMs ms</title>
    <meta http-equiv="refresh" content="@seconds;url=/lite/axes?ms=@IntervalMs" />
    <style>
        body { background: #060916; color: #e8eeff; font-family: Arial, sans-serif; font-size: 14px; margin: 0; padding: 12px 16px; }
        .card { background: #111a33; border: 1px solid #23305a; padding: 10px 14px; margin-bottom: 10px; }
        .eyebrow { color: #4fe3ff; font-size: 11px; font-weight: bold; letter-spacing: 3px; margin: 0; }
        .muted { color: #8292b8; font-size: 12px; margin: 0; }
        table { width: 100%; border-collapse: collapse; }
        td { padding: 4px 0; }
        .name { color: #4fe3ff; font-size: 22px; font-weight: bold; width: 36px; }
        .val { font-family: "Courier New", monospace; font-size: 22px; font-weight: bold; width: 170px; text-align: right; padding-right: 14px; }
        .unit { color: #8292b8; width: 34px; }
        .track { background: #060916; border: 1px solid #23305a; height: 14px; }
        .pos { height: 14px; background: #4fe3ff; }
        a.btn { background: #23305a; color: #e8eeff; padding: 4px 10px; margin-right: 6px; text-decoration: none; font-size: 12px; }
        a.on { background: #4fe3ff; color: #060916; font-weight: bold; }
    </style>
</head>
<body>
    <div class="card">
        <p class="eyebrow">STYKKER LITE · ACHSEN</p>
        <p class="muted">Server @now.ToString("HH:mm:ss.fff") · Aktualisierung alle @IntervalMs ms</p>
    </div>
    <div class="card">
        <table>
            @foreach (var a in axes)
            {
                var pct = (int)Math.Round((a.Value - a.Min) / (a.Max - a.Min) * 100);
                <tr>
                    <td class="name">@a.Name</td>
                    <td class="val">@Fmt(a.Value)</td>
                    <td class="unit">@a.Unit</td>
                    <td><div class="track"><div class="pos" style="width: @(pct)%"></div></div></td>
                </tr>
            }
        </table>
    </div>
    <div>
        @for (int i = 0; i < Speeds.Length; i++)
        {
            var ms = Speeds[i];
            <a class="btn @(ms == IntervalMs ? "on" : "")" href="/lite/axes?ms=@ms" accesskey="@(i + 1)">@ms ms (@(i + 1))</a>
        }
        <a class="btn" href="/lite" accesskey="b">Zurück (B)</a>
    </div>
</body>
</html>
